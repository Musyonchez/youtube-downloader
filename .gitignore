# Download folder (actual MP3 files -- runtime output, not source)
downloads/

# Runtime data: config + library/history DB. SQLite is binary, so tracking
# it in git (like downloaded.json used to be) would mean an opaque,
# undiffable commit on every single download. Back it up separately
# (filesystem backup / the Docker volume) instead.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal

# Hold folders with music files
hold/hold1/
hold/hold2/

# Temporary recovery folder
temp_recovery/
temp/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environment
venv/
env/
ENV/

# E2E test tooling (tests/e2e/) -- keep package.json/package-lock.json,
# playwright.config.js, and *.spec.js tracked; not node_modules/results.
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/
# Session cookie captured by global-setup.js (docs/15) -- regenerated fresh
# on every test run, never something to commit.
tests/e2e/storageState.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
