# Download folder (actual MP3 files -- runtime output, not source)
downloads/

# Runtime data: config + library/history DB. SQLite is binary, so tracking
# it in git (like downloaded.json used to be) would mean an opaque,
# undiffable commit on every single download. Back it up separately
# (filesystem backup / the Docker volume) instead.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal

# Hold folders with music files
hold/hold1/
hold/hold2/

# Temporary recovery folder
temp_recovery/
temp/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environment
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
